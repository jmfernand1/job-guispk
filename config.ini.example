# Copiar como config.ini junto al ejecutable (o al directorio de trabajo).
# Tambien pueden usarse las variables de entorno GUISPK_DSN / GUISPK_SCHEMA /
# GUISPK_BACKUP_DB / GUISPK_BACKEND / GUISPK_SQLITE_PATH (tienen prioridad).
# NUNCA poner credenciales aqui: usuario y password se piden al arrancar (o se
# precargan de USERNAME / PSWD / DSNLZ).
[guispk]
# DSN ODBC de Impala (el corporativo ya provisionado en cada maquina).
dsn = DSN_IMPALA_CORP
# Esquema donde viven las tablas de coordinacion guispk_* y las tablas
# enmascaradas. Omitir para usar el default.
schema = proceso_enmascarado
# SOLO app interna: archivo .db donde se respaldan las tablas guispk_*, en la
# carpeta OneDrive del equipo interno. La app aliada ignora esta clave.
# Omitir para elegir el archivo a mano en la pestana Respaldo.
backup_db = ~/OneDrive/guispk/guispk_backup.db
# Donde vive la coordinacion: impala (default) o sqlite. Con sqlite las apps
# trabajan sobre el archivo espejo mientras el DSN esta intermitente; no se
# puede ejecutar enmascaramiento en ese modo. Se conmuta tambien desde la UI.
# backend = impala
# Archivo .db a usar con backend = sqlite. Omitir para usar el de backup_db:
# es el mismo archivo, con las mismas tablas.
# sqlite_path = ~/OneDrive/guispk/guispk_backup.db
